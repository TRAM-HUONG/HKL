# Khoi tao githup
  git remote add origin https://github.com/TRAM-HUONG/HKL.git
# push code len github
  git branch -M main
  git push origin main --force
# 1. Tải thông tin mới nhất từ GitHub về (nhưng chưa áp dụng)
git fetch origin main

# 2. Ép code trong máy quay về trạng thái của GitHub (Xóa mọi sửa đổi local)
git reset --hard origin/main

# 3. Xóa các file "rác" không có trên GitHub nhưng đang có ở máy bạn
git clean -fd

# 1. Xóa thư mục node_modules và file lock
rm -rf node_modules package-lock.json

# 2. Cài đặt lại các thư viện
npm install

# 3. Chạy lại dự án
npm run dev